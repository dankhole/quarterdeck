{
  "name": "quarterdeck",
  "version": "0.12.16",
  "packageManager": "npm@11.19.1",
  "quarterdeck": {
    "desktopRelease": "adhoc-v1",
    "windowsDesktopRelease": "unsigned-v1"
  },
  "description": "A quarterdeck foundation for coding agents",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "quarterdeck",
    "agents",
    "cli",
    "task-management",
    "typescript"
  ],
  "homepage": "https://github.com/dankhole/quarterdeck",
  "bugs": {
    "url": "https://github.com/dankhole/quarterdeck/issues"
  },
  "author": "Quarterdeck",
  "repository": {
    "type": "git",
    "url": "https://github.com/dankhole/quarterdeck"
  },
  "type": "module",
  "bin": {
    "quarterdeck": "dist/cli.js"
  },
  "man": "./man/quarterdeck.1",
  "files": [
    "dist",
    "man",
    "README.md",
    "LICENSE",
    "npm-postinstall.cjs"
  ],
  "engines": {
    "node": ">=22.22.2"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": false,
    "node-pty": true
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "bootstrap": "node scripts/dependency-workflow.mjs bootstrap",
    "install:all": "node scripts/dependency-workflow.mjs bootstrap",
    "build": "node scripts/build-all.mjs",
    "link": "node scripts/dependency-workflow.mjs link",
    "unlink": "npm unlink -g quarterdeck",
    "dev": "node scripts/dev-runtime.mjs",
    "web:build": "npm --prefix web-ui run build",
    "web:typecheck": "npm --prefix web-ui run typecheck",
    "web:test": "npm --prefix web-ui run test --",
    "agent:desktop": "node --import tsx scripts/agent-desktop.ts",
    "desktop:build": "node scripts/desktop-local.mjs build",
    "desktop:install": "node scripts/desktop-local.mjs install",
    "check:agent-instructions": "node scripts/check-agent-instructions.mjs",
    "check:dead-code": "knip",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "npx @biomejs/biome lint src test scripts/agent-desktop.ts scripts/agent-lab web-ui/src vitest.config.ts web-ui/vite.config.ts web-ui/vitest.config.ts",
    "format": "npx @biomejs/biome check --write .",
    "check": "npm run check:agent-instructions && npx @biomejs/biome check . && npm run typecheck && npm run test:release-policy && npm run test -- --mode integration",
    "test": "vitest run",
    "test:fast": "vitest run test/runtime test/utilities",
    "test:integration": "vitest run test/integration --mode integration",
    "test:release-policy": "node --test .github/scripts/desktop-release-artifacts.test.mjs .github/scripts/npm-publication-identity.test.mjs .github/scripts/desktop-signing-preflight.test.mjs .github/scripts/desktop-default-capability.test.mjs",
    "test:package": "node scripts/package-artifact-smoke.mjs",
    "test:windows-smoke": "node scripts/windows-smoke.mjs",
    "test:precommit": "node scripts/precommit.mjs",
    "test:watch": "vitest",
    "prepare": "husky",
    "prepublishOnly": "npm run build && npm run check",
    "postinstall": "node npm-postinstall.cjs"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/node": "^22.20.2",
    "@types/proper-lockfile": "^4.1.4",
    "@types/semver": "^7.8.0",
    "@types/ws": "^8.18.1",
    "@types/yauzl": "3.4.0",
    "@vitest/coverage-v8": "^5.0.3",
    "@xterm/addon-serialize": "0.14.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "knip": "^6.35.1",
    "playwright-core": "1.63.0-alpha-2026-08-31",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.324",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@xterm/headless": "6.0.0",
    "commander": "^15.0.0",
    "ignore": "^7.0.10",
    "node-pty": "^1.2.0-beta.15",
    "open": "^11.0.3",
    "ora": "^9.4.1",
    "p-limit": "^7.3.2",
    "proper-lockfile": "^4.1.2",
    "refractor": "^5.0.0",
    "semver": "^7.8.5",
    "tree-kill": "^1.2.2",
    "vscode-languageserver-protocol": "^3.18.4",
    "ws": "^8.21.3",
    "yauzl": "3.4.0",
    "zod": "^4.6.6"
  }
}
