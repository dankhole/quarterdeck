{
  "name": "quarterdeck",
  "version": "0.12.4",
  "packageManager": "npm@11.19.0",
  "description": "A quarterdeck foundation for coding agents",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "quarterdeck",
    "agents",
    "cli",
    "task-management",
    "typescript"
  ],
  "homepage": "https://github.com/dankhole/quarterdeck",
  "bugs": {
    "url": "https://github.com/dankhole/quarterdeck/issues"
  },
  "author": "Quarterdeck",
  "repository": {
    "type": "git",
    "url": "https://github.com/dankhole/quarterdeck"
  },
  "type": "module",
  "bin": {
    "quarterdeck": "dist/cli.js"
  },
  "man": "./man/quarterdeck.1",
  "files": [
    "dist",
    "man",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.22.2"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": false,
    "node-pty": true
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "bootstrap": "node scripts/dependency-workflow.mjs bootstrap",
    "install:all": "node scripts/dependency-workflow.mjs bootstrap",
    "build": "node scripts/build-all.mjs",
    "dogfood": "node scripts/dogfood.mjs",
    "link": "node scripts/dependency-workflow.mjs link",
    "unlink": "npm unlink -g quarterdeck",
    "dev": "node scripts/dev-runtime.mjs",
    "dev:full": "node scripts/dev-full.mjs",
    "web:dev": "npm --prefix web-ui run dev",
    "web:build": "npm --prefix web-ui run build",
    "web:typecheck": "npm --prefix web-ui run typecheck",
    "web:test": "npm --prefix web-ui run test --",
    "web:e2e": "npm --prefix web-ui run e2e --",
    "agent:lab": "node --import tsx scripts/agent-lab.ts",
    "agent:browser": "node --import tsx scripts/agent-browser.ts",
    "check:agent-instructions": "node scripts/check-agent-instructions.mjs",
    "check:dead-code": "knip",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "npx @biomejs/biome lint src test scripts/agent-lab.ts scripts/agent-lab scripts/playwright-e2e-runtime.ts web-ui/src web-ui/tests vitest.config.ts web-ui/vite.config.ts web-ui/vitest.config.ts web-ui/playwright.config.ts",
    "format": "npx @biomejs/biome check --write .",
    "check": "npm run check:agent-instructions && npx @biomejs/biome check . && npm run typecheck && npm run test",
    "test": "vitest run",
    "test:fast": "vitest run test/runtime test/utilities",
    "test:integration": "vitest run test/integration",
    "test:package": "node scripts/package-artifact-smoke.mjs",
    "test:windows-smoke": "node scripts/windows-smoke.mjs",
    "test:precommit": "npm run test:fast",
    "test:watch": "vitest",
    "prepare": "husky",
    "prepublishOnly": "npm run build && npm run check"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/node": "^22.20.1",
    "@types/proper-lockfile": "^4.1.4",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "knip": "^6.32.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.241",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "commander": "^15.0.0",
    "node-pty": "^1.2.0-beta.15",
    "open": "^11.0.1",
    "ora": "^9.4.1",
    "p-limit": "^7.3.1",
    "proper-lockfile": "^4.1.2",
    "tree-kill": "^1.2.2",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  }
}
