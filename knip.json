{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"include": ["files", "dependencies", "unlisted", "unresolved"],
	"workspaces": {
		".": {
			"entry": [
				"src/cli.ts",
				"scripts/*.{ts,mjs}",
				"scripts/agent-lab/**/*.{ts,cjs}",
				"test/**/*.test.ts",
				"test/**/*.integration.test.ts"
			],
			"project": ["src/**/*.ts", "scripts/**/*.{ts,mjs,cjs}", "test/**/*.{ts,cjs}"]
		},
		"web-ui": {
			"entry": [
				"src/**/*.test.{ts,tsx}",
				"*.config.ts"
			],
			"project": ["src/**/*.{ts,tsx,css}", "*.ts"]
		}
	}
}
