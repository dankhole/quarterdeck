{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Internal Runtime",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/tsx",
      "args": ["watch", "src/cli.ts", "--internal-runtime", "--port", "3500"],
      "env": {
        "NODE_ENV": "development",
        "QUARTERDECK_STATE_HOME": "${workspaceFolder}/.quarterdeck-debug-state"
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Run Tests",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/vitest",
      "args": ["run"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
