{
	"name": "quarterdeck-desktop",
	"productName": "Quarterdeck",
	"version": "0.12.8",
	"private": true,
	"description": "The isolated macOS desktop shell for Quarterdeck",
	"author": "Quarterdeck",
	"license": "Apache-2.0",
	"type": "module",
	"main": "dist/main.js",
	"engines": {
		"node": ">=22.22.2"
	},
	"config": {
		"forge": "./forge.config.mjs"
	},
	"quarterdeckDesktop": {
		"bundleId": "io.github.dankhole.quarterdeck",
		"minimumMacOSVersion": "13.0",
		"nodeVersion": "22.22.2",
		"nodeArchives": {
			"arm64": "db4b275b83736df67533529a18cc55de2549a8329ace6c7bcc68f8d22d3c9000",
			"x64": "12a6abb9c2902cf48a21120da13f87fde1ed1b71a13330712949e8db818708ba"
		}
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"icon": "node scripts/generate-app-icon.mjs",
		"check": "biome check . && npm run typecheck && npm run test",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"stage": "node scripts/stage-runtime.mjs",
		"start": "node scripts/desktop-command.mjs start",
		"package": "node scripts/desktop-command.mjs package",
		"make": "node scripts/desktop-command.mjs make",
		"verify": "node scripts/verify-artifact.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@electron-forge/cli": "8.0.1",
		"@electron-forge/maker-dmg": "8.0.1",
		"@electron-forge/maker-zip": "8.0.1",
		"@electron-forge/plugin-fuses": "8.0.1",
		"@electron/fuses": "2.1.3",
		"@types/node": "22.20.2",
		"electron": "44.5.1",
		"esbuild": "0.28.2",
		"typescript": "7.0.2",
		"vitest": "5.0.3"
	},
	"allowScripts": {
		"esbuild": true,
		"fsevents": false,
		"fs-xattr": true,
		"macos-alias": true
	}
}
